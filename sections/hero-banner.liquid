{{ 'hero-banner.css' | asset_url | stylesheet_tag }}
<section class="hero-banner"
  style="background: {{ section.settings.background_color }};"
>
  <div class="page-width" style="
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom}}px;
 ">
 <div class="hero-banner__content">
 <h1
  style="
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px !important;
  "
>
  {{ section.settings.heading }}
</h1>

  <p style="color: {{ section.settings.subheading_color }};">{{section.settings.subheading}}</p>
<div class="hero-banner__buttons">
{% for block in section.blocks %}

  {% if block.settings.button_label != blank %}

  <a
  class="hero-banner__button"
  href="{{ block.settings.button_link }}"
  style="
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
  "
>
  {{ block.settings.button_label }}
</a>

  {% endif %}

{% endfor %}
</div>
  </div>
<div class="hero-banner__image">
  {% if section.settings.image_1 %}
    {{
      section.settings.image_1
      | image_url: width: 1200
      | image_tag:
        class: 'hero-banner__img',
        loading: 'lazy',
        alt: section.settings.heading
    }}
  {% endif %}
</div>
       </div>
</section>

{% schema %}
{
   "name": "Hero Banner",
  "settings": [
    {
  "type": "color",
  "id": "background_color",
  "label": "Background Color",
  "default": "#f8f8f8"
},
{
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOIR"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#111111"
    },
  
    {
      "type": "range",
  "id": "heading_size",
  "min": 20,
  "max": 80,
  "step": 4,
  "unit": "px",
  "label": "Heading Size",
  "default": 40
},
          {
  "type": "range",
  "id": "padding_top",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Padding Top",
  "default": 36
},
    {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Discover the art of fine fragrance" 
    },
         {
      "type": "color",
      "id": "subheading_color",
      "label": "Color",
      "default": "#111111"
    },
    {
        "type": "image_picker",
        "id": "image_1",
        "label": "Hero Image"
    },
    {
  "type": "range",
  "id": "image_height_desktop",
  "label": "Desktop Image Height",
  "min": 300,
  "max": 800,
  "step": 20,
  "unit": "px",
  "default": 600
},
{
  "type": "range",
  "id": "image_height_mobile",
  "label": "Mobile Image Height",
  "min": 200,
  "max": 500,
  "step": 20,
  "unit": "px",
  "default": 360
},
      {
    "type": "range",
  "id": "padding_bottom",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Padding Bottom",
  "default": 36

      }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings":  [
        
    {
      "type": "text",
       "id": "button_label",
       "label": "Button",
       "default": "Shop Now!"
    },
     {
      "type": "color",
      "id": "button_background_color",
      "label": "Background Color",
      "default": "#1a44af"
    },
      {
      "type": "color",
      "id": "button_text",
      "label": "Text Color",
      "default": "#ffffff"
    },
              {
  "type": "range",
  "id": "button_border_radius",
  "min": 0,
  "max": 50,
  "step": 2,
  "unit": "px",
  "label": "Border Radius",
  "default": 6
},
          {
  "type": "range",
  "id": "button_font_size",
  "min": 12,
  "max": 30,
  "step": 2,
  "unit": "px",
  "label": "Font Size",
  "default": 14
},
     {
      "type": "url",
       "id": "button_link",
       "label": "Button Link"
    }
      ]
    }
  ],
  "presets": [
  {
    "name": "Hero Banner",
    "blocks": [
      {
        "type": "button"
      }
    ]
  }
]
}
{% endschema %}