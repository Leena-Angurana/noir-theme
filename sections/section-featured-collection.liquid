{{ 'custom-featured-collection.css' | asset_url | stylesheet_tag }}

<section
  class="featured-collection"
  style="
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    <div class="featured-collection__header">

     <h2
  class="featured-collection__heading"
  style="color: {{ section.settings.heading_color }};"
>
  {{ section.settings.heading }}
</h2>

      {% if section.settings.subheading != blank %}
        <p
  class="featured-collection__subheading"
  style="color: {{ section.settings.subheading_color }};"
>
  {{ section.settings.subheading }}
</p>
      {% endif %}

    </div>

 <div class="featured-collection__grid">

  {% if section.settings.collection != blank %}

    {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

  <div class="product-card {% unless product.available %}product-card--sold-out{% endunless %}">

  <div class="product-card__media">
  
{% unless product.available %}

  <span class="product-card__badge product-card__badge--sold-out">
    Sold Out
  </span>

{% else %}

{% if product.available and product.compare_at_price > product.price %}

  {% assign discount = product.compare_at_price
    | minus: product.price
    | times: 100
    | divided_by: product.compare_at_price
  %}

  <span class="product-card__badge">
    -{{ discount }}%
  </span>

{% endif %}

{% endunless %}
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 700
        | image_tag:
          class: 'product-card__image',
          loading: 'lazy',
          alt: product.title
      }}
    {% endif %}

  </div>

  <div class="product-card__content">

    <p class="product-card__vendor">
      {{ product.vendor }}
    </p>

    <h3 class="product-card__title">
  {% if product.available %}
    <a href="{{ product.url }}">
      {{ product.title }}
    </a>
  {% else %}
    {{ product.title }}
  {% endif %}
</h3>

   <div class="product-card__price-wrapper">

  {% if product.compare_at_price > product.price %}

    <span class="product-card__price product-card__price--sale">
      {{ product.price | money }}
    </span>

    <span class="product-card__compare-price">
      {{ product.compare_at_price | money }}
    </span>

  {% else %}

    <span class="product-card__price">
      {{ product.price | money }}
    </span>

  {% endif %}

</div>

  </div>
</div>

    {% endfor %}

{% else %}

  <div class="featured-collection__empty">
    <h3>No collection selected</h3>
    <p>Please choose a collection from the Theme Editor.</p>
  </div>

{% endif %}

</div> <!-- featured-collection__grid -->
{% if section.settings.show_view_all and section.settings.collection != blank %}
  <div class="featured-collection__footer">
    <a
      href="{{ section.settings.collection.url }}"
      class="featured-collection__button"
    >
      {{ section.settings.view_all_text }}
      &rarr;
    </a>
  </div>
{% endif %}

</div> <!-- page-width -->
</section>



{% schema %}
{
  "name": " Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our bestselling fragrances."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },

    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },

    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View Collection"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#666666"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}